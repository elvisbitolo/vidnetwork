# ===== Firebase Web (client SDK) — from Firebase console → Project settings → Your apps =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=christa-patel.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=christa-patel
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=christa-patel.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=310624372536
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin (server SDK) =====
# Either paste the whole service-account JSON (downloaded from
# Project settings → Service accounts → Generate new private key) OR set the three fields below.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=christa-patel
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===== LiveKit Cloud =====
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ===== Stripe =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Legacy single-plan prices
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Membership tiers (monthly / yearly). PayPal is enabled automatically via Stripe.
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# ===== LiveKit Egress (recordings) =====
# Recording files are uploaded to S3. Leave unset to hide the recording feature.
LIVEKIT_EGRESS_S3_REGION=
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
# Optional public base URL for S3-hosted recording downloads, e.g. https://your-cdn.example.com
LIVEKIT_EGRESS_S3_PUBLIC_URL=

# ===== Web push notifications (optional) =====
# Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@christa-patel.com

# ===== Cron (Vercel) =====
# Used by vercel.json cron auth. Must be a long random string.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Email (optional — for comment/RSVP notifications) =====
# If RESEND_API_KEY is not set, emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM=Community <no-reply@christa-patel.com>
