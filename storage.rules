rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isNotSuspended() {
      let u = get(/databases/(default)/documents/users/$(request.auth.uid));
      return isSignedIn() && (!u.exists || u.data.suspended != true);
    }

    function isActiveSub() {
      let sub = get(/databases/(default)/documents/subscriptions/$(request.auth.uid)).data;
      return isNotSuspended()
        && sub != null
        && (sub.status in ['active', 'trialing', 'past_due'])
        && (sub.currentPeriodEnd == null || sub.currentPeriodEnd > request.time);
    }

    function subTier() {
      let sub = get(/databases/(default)/documents/subscriptions/$(request.auth.uid)).data;
      return sub != null && sub.tier != null ? sub.tier : 'standard';
    }

    function isOwner() {
      let u = get(/databases/(default)/documents/users/$(request.auth.uid));
      return isSignedIn() && u.exists && u.data.role == 'owner';
    }

    function meetsTier(requiredTier) {
      return requiredTier == null || requiredTier == '' || requiredTier == 'standard'
        || subTier() == 'premium';
    }

    function canReadLesson(lessonId) {
      let lesson = get(/databases/(default)/documents/lessons/$(lessonId));
      if (!lesson.exists || lesson.data.courseId == null) return false;
      let course = get(/databases/(default)/documents/courses/$(lesson.data.courseId));
      return course.exists
        && course.data.status == 'published'
        && meetsTier(course.data.requiredTier);
    }

    match /posts/{postId}/{fileName} {
      allow read: if isSignedIn() && isActiveSub();
      allow create, update: if isSignedIn() && isActiveSub()
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isSignedIn()
        && (resource.metadata.uid == request.auth.uid || isOwner());
    }

    match /lessons/{lessonId}/{fileName} {
      allow read: if isSignedIn() && isActiveSub() && canReadLesson(lessonId);
      allow create, update: if isOwner()
        && request.resource.contentType.matches('video/.*|application/pdf');
      allow delete: if isOwner();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
